# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Project Settings → Database → Connection string

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://project_link.supabase.co
SUPABASE_ANON_KEY=sb_publishable_key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_ac_key

# --- Postgres (Alembic + direct DB access) ---

# Use the DIRECT connection (host: db.<ref>.supabase.co).
# Do NOT use the transaction pooler URL (pooler.supabase.com) — migrations require a session connection.
# URL-encode special characters in the password.
DATABASE_URL="postgresql://postgres.<project-ref>:<encoded-password>@db.<project-ref>.supabase.co:5432/postgres"
# --- Google Gemini ---

GEMINI_API_KEY="AQ.Ab8RN6JYZ6tZpuxaQYLIuV6LrCO-LA1A5Z6QNk60gObg8zTJsA"
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=1536

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173